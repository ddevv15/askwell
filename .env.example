# Copy to .env.local (never commit it). Values per environment: see docs/project.md §11.

# Supabase project URL (public; RLS is the boundary)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (public; RLS is the boundary)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key: acts as service_role and skips RLS. Server only, read only by lib/supabase/service.ts
SUPABASE_SECRET_KEY=

# Clerk publishable key (client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (server only)
CLERK_SECRET_KEY=
# Clerk webhook signing secret, used to verify the Clerk webhook (server only)
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI API key for chat + embeddings (server only)
OPENAI_API_KEY=

# Arcjet key for rate limiting and prompt-injection checks (server only)
ARCJET_KEY=

# PostHog project key (public)
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host, e.g. the US or EU ingest URL (public)
NEXT_PUBLIC_POSTHOG_HOST=

# Public base URL of this app, e.g. http://localhost:3000 locally
NEXT_PUBLIC_APP_URL=

# Public key of the project whose widget runs on the landing page (server, read at request time; per environment)
LANDING_WIDGET_KEY=
